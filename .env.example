# Meta Marketing API — long-lived System User token with `ads_read` on the account.
# Business Settings → System Users → Generate token → scope: ads_read.
META_ACCESS_TOKEN=

# Tajmer Booking — "Primær annoncekonto - Tajmer Booking".
# Account id WITHOUT the leading "act_".
META_AD_ACCOUNT_ID=1222051031227513

# Graph API version. v21.0 or newest stable.
META_API_VERSION=v21.0

# Admin password — unlocks the full dashboard (spend, metrics, Ads Manager).
SITE_PASSWORD=

# Client password — unlocks the client version: creatives only, no spend or
# performance data (stripped server-side). Leave blank to disable the client view.
CLIENT_PASSWORD=

# --- Preview / approval feature ---
# Vercel KV / Upstash Redis. Provisioned automatically when you add the
# integration (either KV_REST_API_* or UPSTASH_REDIS_REST_* is fine).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Bearer token for the read-only agent endpoints
# (GET /api/preview/feedback/open, POST /api/preview/feedback/resolve).
PREVIEW_AGENT_TOKEN=

# --- Budget tool (admin only) ---
# Read-only Google service account used to read the budget/ticket sheets.
# Create one in Google Cloud, enable the Google Sheets API, then SHARE each
# sheet with the service account's client_email. Paste the whole downloaded
# JSON key as a single value here (Vercel env only — never commit it).
GOOGLE_SERVICE_ACCOUNT_JSON=

# The budget spreadsheet id (the long id in its URL). Tabs: "Plan", "Tiltag".
GOOGLE_SHEET_ID=1MIbkfCaMIcopxFB_-gYDCFRITe8XiRYczWUWHzrRm0M

# Set to 1/true to let the client role read /api/budget/* (off by default →
# admin only; client gets 403).
BUDGET_CLIENT_ENABLED=

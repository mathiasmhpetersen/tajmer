# Meta Marketing API — long-lived System User token with `ads_read` on the account.
# Business Settings → System Users → Generate token → scope: ads_read.
META_ACCESS_TOKEN=

# Tajmer Booking — "Primær annoncekonto - Tajmer Booking".
# Account id WITHOUT the leading "act_".
META_AD_ACCOUNT_ID=1222051031227513

# Graph API version. v21.0 or newest stable.
META_API_VERSION=v21.0

# Admin password — unlocks the full dashboard (spend, metrics, Ads Manager).
SITE_PASSWORD=

# Client password — unlocks the client version: creatives only, no spend or
# performance data (stripped server-side). Leave blank to disable the client view.
CLIENT_PASSWORD=
